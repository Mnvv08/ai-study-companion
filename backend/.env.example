# ─────────────────────────────────────────────────────────────────
# .env.example — Copy this to .env and fill in your real values.
# NEVER commit your real .env file to Git.
# ─────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────
APP_NAME="AI Study Companion"
APP_ENV=development          # development | production
DEBUG=true

# ── PostgreSQL ────────────────────────────────────────────────────
POSTGRES_USER=studyuser
POSTGRES_PASSWORD=changeme
POSTGRES_DB=study_companion
POSTGRES_HOST=postgres       # Service name from docker-compose (not localhost!)
POSTGRES_PORT=5432

# Assembled by config.py from the above — do not edit this manually
DATABASE_URL=postgresql://studyuser:changeme@postgres:5432/study_companion

# ── JWT Auth ──────────────────────────────────────────────────────
SECRET_KEY=replace-this-with-a-long-random-secret-key-32-chars-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── LLM API ───────────────────────────────────────────────────────
# Used in Phase 1+. Add your real key here locally.
OPENAI_API_KEY=sk-your-openai-key-here
LLM_MODEL=gpt-4o-mini         # Cheap + capable for our use case

# ── Embeddings ────────────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small

# ── ChromaDB ──────────────────────────────────────────────────────
CHROMA_HOST=chromadb          # Service name from docker-compose
CHROMA_PORT=8000

# ── File Uploads ──────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20
ALLOWED_EXTENSIONS=pdf,pptx

# ─────────────────────────────────────────────────────────────────
# .env.example — Copy this to .env (or backend/.env) and fill in your real values.
# NEVER commit your real .env file to Git.
# ─────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────
APP_NAME="AI Study Companion"
APP_ENV=development          # development | production
DEBUG=true

# ── PostgreSQL ────────────────────────────────────────────────────
POSTGRES_USER=studyuser
POSTGRES_PASSWORD=changeme
POSTGRES_DB=study_companion
POSTGRES_HOST=postgres       # Service name from docker-compose (not localhost inside docker!)
POSTGRES_PORT=5432

# Assembled database URL used by SQLAlchemy
DATABASE_URL=postgresql://studyuser:changeme@postgres:5432/study_companion

# ── JWT Auth ──────────────────────────────────────────────────────
SECRET_KEY=replace-this-with-a-long-random-secret-key-32-chars-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── xAI / Grok (Text Generation) ─────────────────────────────────
# xAI powers all chat/text generation (notes, flashcards, MCQs, Q&A).
# Get your key at https://console.x.ai
XAI_API_KEY=xai-your-xai-api-key-here
XAI_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-3-mini

# ── OpenAI (Embeddings Only) ─────────────────────────────────────
# OpenAI is used ONLY for vector embeddings (text-embedding-3-small).
# xAI does not currently offer an embeddings endpoint.
OPENAI_API_KEY=sk-your-openai-key-here
EMBEDDING_MODEL=text-embedding-3-small

# ── ChromaDB ──────────────────────────────────────────────────────
CHROMA_HOST=chromadb          # Service name from docker-compose
CHROMA_PORT=8000

# ── File Uploads ──────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20
ALLOWED_EXTENSIONS=pdf,pptx
